DATABASE_URL=postgresql+psycopg://propsearch:propsearch@localhost:5433/propsearch
# rules (no key) or anthropic (Claude tool calling, falls back to rules on any failure)
PARSER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_SUMMARY=false
# hashing (no download) or bge-m3; none or bge (cross-encoder reranker)
EMBEDDER=hashing
RERANKER=none
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
