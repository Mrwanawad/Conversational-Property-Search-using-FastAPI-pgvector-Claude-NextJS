# Postgres with pgvector. docker compose maps it to localhost:5433.
DATABASE_URL=postgresql+psycopg://propsearch:propsearch@localhost:5433/propsearch

# Query understanding: "rules" (no key needed) or "anthropic" (Claude tool calling, falls back to rules on failure).
PARSER=rules
# PARSER=llm: any OpenAI-compatible endpoint (Groq default; OpenRouter: https://openrouter.ai/api/v1)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# on_unknown = rules first, LLM only for messages with unread terms; always = LLM every turn
LLM_MODE=on_unknown
LLM_REASONING_EFFORT=low
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_SUMMARY=false

# Retrieval: "hashing" needs no model download; "bge-m3" / "bge" need the [ml] extra.
EMBEDDER=hashing
RERANKER=none

# Observability (optional).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

CORS_ORIGINS=["http://localhost:3000"]
